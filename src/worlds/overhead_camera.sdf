<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">

    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 3 0 1.57 0</pose>

      <link name="camera_link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
        </visual>

        <sensor name="overhead_rgb" type="camera">
          <always_on>true</always_on>
          <update_rate>30</update_rate>

          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>20</far>
            </clip>
          </camera>

          <topic>/overhead_camera/image</topic>
        </sensor>

      </link>
    </model>

  </world>
</sdf>
